<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <!-- POM的模型版本 -->
    <modelVersion>4.1.0</modelVersion>

    <!-- Inherit defaults from Ddd4j 2.0.x -->
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-parent</artifactId>
        <version>3.0.x.20260630-SNAPSHOT</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>io.ddd4j.quarkus</groupId>
    <artifactId>ddd4j-quarkus</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>ddd4j-quarkus</name>
    <description>Ddd4j Projects For Quarkus (no Spring Boot)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <revision>4.0.x.20260630-SNAPSHOT</revision>
        <ddd4j.version>3.0.x.20260730-SNAPSHOT</ddd4j.version>
        <!-- 与 ddd4j 3.0.x 底座保持一致（主仓产物 major=65/Java 21；
             若保持 17，运行时加载主仓依赖将抛 UnsupportedClassVersionError。
             Quarkus 3.7+ 官方亦鼓励 Java 21） -->
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <!--
            Quarkus 轨道专用：ddd4j 仓库未管理这些版本。
            ddd4j 主仓 quarkus-bom 由本仓 dependencies BOM 显式覆盖为 3.38.2，
            确保 quarkus-maven-plugin 与运行时版本一致。
            其余 Maven 插件版本由 ddd4j 根 pom 统一管理，本仓库不重复声明。
        -->
        <quarkus-bom.version>3.38.2</quarkus-bom.version>
        <quarkus.build.skip>false</quarkus.build.skip>
        <maven-quarkus-plugin.version>3.38.2</maven-quarkus-plugin.version>
    </properties>

    <modules>
        <module>ddd4j-quarkus-bom</module>
        <module>ddd4j-quarkus-dependencies</module>
        <!-- Quarkus 深度适配层：核心运行时已收敛到 io.ddd4j:ddd4j-runtime-quarkus，保留 ddd/auth/data/mq/cache/web 等深度适配模块 -->
        <module>ddd4j-quarkus-ddd</module>
        <!-- 领域聚合（对齐 ddd4j-boot 结构） -->
        <module>ddd4j-quarkus-data</module>
        <module>ddd4j-quarkus-cache</module>
        <module>ddd4j-quarkus-mq</module>
        <module>ddd4j-quarkus-extensions</module>
        <module>ddd4j-quarkus-auth</module>
        <!-- Web 集成（对应 ddd4j-boot 的 ddd4j-boot-web，对齐 ddd4j-boot-web-{webmvc,webflux}） -->
        <module>ddd4j-quarkus-web</module>
        <module>ddd4j-quarkus-parent</module>
        <module>ddd4j-quarkus-samples</module>
    </modules>

    <!--
        JUnit 4（test，全局兜底）：Quarkus Dev Services 处理器（如 MySQLDevServicesProcessor）
        加载时引用 org.junit.rules.TestRule（junit4），Quarkus 3 仅传递 junit-jupiter。
        所有继承本根 POM 的模块（web/ddd/auth/extensions/samples 等）在 @QuarkusTest 时
        都需要 junit4，否则构建阶段 NoClassDefFoundError。版本由 ddd4j 仓库统一管理（4.13.2）。
    -->
    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            框架模块公共测试依赖（继承本根 POM 而非 ddd4j-quarkus-parent 的模块）：
            @QuarkusTest 需要 quarkus-junit；HTTP 断言用 rest-assured；断言用 assertj。
            业务项目父 POM（ddd4j-quarkus-parent）同样提供这些依赖，业务项目不受影响。
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <distributionManagement>
        <repository>
            <id>2624322-release-6F6h6R</id>
            <url>https://packages.aliyun.com/6927b116e6c3e0425dbdf60d/maven/2624322-release-6f6h6r</url>
        </repository>
        <snapshotRepository>
            <id>2624322-snapshot-3EoOv3</id>
            <url>https://packages.aliyun.com/6927b116e6c3e0425dbdf60d/maven/2624322-snapshot-3eoov3</url>
        </snapshotRepository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo1.maven.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>aliyun-central</id>
            <url>https://maven.aliyun.com/repository/central</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>2624322-release-6F6h6R</id>
            <url>https://packages.aliyun.com/6927b116e6c3e0425dbdf60d/maven/2624322-release-6f6h6r</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>central</id>
            <url>https://repo1.maven.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>aliyun-central</id>
            <url>https://maven.aliyun.com/repository/central</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <!--
                flatten-maven-plugin：Maven 4 原生支持 CI-friendly ${revision} 解析，
                flatten 插件冗余，skip=true 禁用（避免 flatten 1.8.0 内嵌的 Maven 3
                ModelBuilder 读 POM 4.1.0 报 'modelVersion 4.1.0 is newer' 错误）。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <!--
            框架模块（mq/extensions/auth/data/cache/ddd/web）的公共构建配置：
            这些模块继承本根 POM（而非 ddd4j-quarkus-parent 业务父 POM，避免默认
            全家桶依赖 panache/mysql/quartz/easyexcel 等传递进框架 jar），
            因此把 Quarkus 测试/编译所需配置收敛到根 POM 统一提供。
        -->
        <pluginManagement>
            <plugins>
                <!-- Quarkus 构建（模块显式声明时生效，如 mq-testcontainers） -->
                <plugin>
                    <groupId>io.quarkus.platform</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus-bom.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <skip>${quarkus.build.skip}</skip>
                    </configuration>
                </plugin>
                <!-- 编译：release + -parameters（覆盖 ddd4j-parent 的 source/target） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <!-- Unit Test：JVM LogManager 切到 JBoss，避免与 Quarkus 日志桥接冲突 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <!-- Integration Test：JBoss LogManager -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!--
        集成测试 profile（CI 使用）：显式声明 testcontainers 测试的执行意图。
        - 激活后启用 Testcontainers 容器 reuse（见 ddd4j-quarkus-mq-testcontainers
          的 testcontainers.properties 与 CI 中 ~/.testcontainers.properties），
          减少 CI / 本地重复拉取与启动 broker 镜像的开销。
        - 预留 failsafe 分离点：后续若将集成测试迁移到 *IT 命名 + failsafe，
          在此 profile 绑定 maven-failsafe-plugin 即可，无需改动 CI 脚本。
    -->
    <profiles>
        <profile>
            <id>integration</id>
            <properties>
                <testcontainers.reuse.enable>true</testcontainers.reuse.enable>
            </properties>
        </profile>
    </profiles>

</project>
