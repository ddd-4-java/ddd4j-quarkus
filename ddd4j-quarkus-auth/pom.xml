<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-quarkus-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-auth</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j-quarkus 认证授权整合聚合：license / satoken / security / shiro / jwt 与 Quarkus CDI 深度整合。
        底层复用 io.ddd4j:ddd4j-auth-* 纯 Java 实现（jwt 为无状态验证型，直接基于 SmallRye JWT），本层提供 CDI Bean、Quarkus
        ExceptionMapper。
        对齐 ddd4j-boot-auth 的深度适配定位；jwt 属于 Quarkus 轨道额外的无状态令牌适配。
    </description>

    <subprojects>
        <subproject>ddd4j-quarkus-auth-license</subproject>
        <subproject>ddd4j-quarkus-auth-satoken</subproject>
        <subproject>ddd4j-quarkus-auth-security</subproject>
        <subproject>ddd4j-quarkus-auth-shiro</subproject>
        <subproject>ddd4j-quarkus-auth-jwt</subproject>
    </subprojects>

</project>
