<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-auth</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-auth-license</artifactId>
    <description>
        ddd4j-quarkus License 授权校验整合。
        底层复用 io.ddd4j:ddd4j-extension-license 纯 Java 实现，本层提供 Quarkus CDI 装配。
    </description>

    <dependencies>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-extension-license</artifactId>
        </dependency>
        <!--
            ddd4j 2.0.x 已发布的 ddd4j-extension-license POM 未提供可用的 TrueLicense
            传递依赖；版本由 ddd4j-quarkus-dependencies 管理（1.33），此处保留直接声明。
        -->
        <dependency>
            <groupId>de.schlichtherle.truelicense</groupId>
            <artifactId>truelicense-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- 上述 ddd4j-extension-license（compile）同时覆盖测试用途
             （LicenseKit / LicenseCreator / LicenseKeyStoreGenerator 用于端到端测试：
             keytool 生成 keystore → 签发 → 安装 → 缓存命中），不再重复声明 test scope -->
    </dependencies>
</project>
