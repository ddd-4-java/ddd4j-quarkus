<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-auth</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-auth-license</artifactId>
    <description>
        ddd4j-quarkus License 授权校验整合。
        底层复用 io.ddd4j:ddd4j-auth-license 纯 Java 实现，本层提供 Quarkus CDI 装配。
    </description>

    <dependencies>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-auth-license</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!--
            truelicense-core：主仓 ddd4j-auth-license 发布 POM 声明了该依赖但未带版本（其
            effective model invalid，传递依赖不可用）。版本由 ddd4j-quarkus-dependencies 管理
            （1.33），此处显式声明使传递依赖恢复可用并消除无效 POM 警告。
        -->
        <dependency>
            <groupId>de.schlichtherle.truelicense</groupId>
            <artifactId>truelicense-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- Test scope：3.0.x 主仓 license 已从 ddd4j-auth-license 迁出至
             ddd4j-extension-license（LicenseKit / LicenseCreator / LicenseKeyStoreGenerator
             用于端到端测试：keytool 生成 keystore → 签发 → 安装 → 缓存命中） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-extension-license</artifactId>
            <version>${ddd4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
