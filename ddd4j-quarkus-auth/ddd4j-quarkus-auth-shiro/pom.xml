<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-auth</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-auth-shiro</artifactId>
    <description>
        ddd4j-quarkus + Apache Shiro 整合：CDI Bean 注册 ShiroSubjectProvider + Quarkus ExceptionMapper。
        底层复用 io.ddd4j:ddd4j-auth-shiro（纯 Java）。
    </description>

    <dependencies>
        <!-- ddd4j auth shiro 纯 Java 实现 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-auth-shiro</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!-- ddd4j core -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!-- Apache Shiro -->
        <dependency>
            <groupId>org.apache.shiro</groupId>
            <artifactId>shiro-core</artifactId>
        </dependency>
        <!-- Quarkus CDI -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- Quarkus REST（ExceptionMapper；3.31+ 原 quarkus-resteasy-reactive-jackson 重命名为 quarkus-rest-jackson） -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
    </dependencies>

</project>
