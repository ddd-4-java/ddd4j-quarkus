<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-quarkus-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-parent</artifactId>
    <packaging>pom</packaging>
    <description>Ddd4j Projects Parent for Quarkus (no Spring Boot)</description>

    <properties>
        <!-- Docker 镜像构建/推送开关：业务项目在自身 pom 中覆盖 -->
        <docker.skip>true</docker.skip>
        <docker.push.skip>true</docker.push.skip>

        <!-- Quarkus build goal 开关（默认 false，业务项目正常构建 uber-jar）。
             示例项目（ddd4j-quarkus-samples）覆盖为 true 跳过 Hibernate 增强步骤。 -->
        <quarkus.build.skip>false</quarkus.build.skip>

        <!--
            Maven 插件版本由 ddd4j 仓库根 pom 统一管理（maven-compiler / enforcer / surefire /
            failsafe / source / jar / resources / install / deploy / exec / git-commit-id /
            flatten / docker 等），本 parent 不重复声明，避免版本漂移。
        -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                ddd4j-quarkus-dependencies：Quarkus 轨道全量版本管理（ddd4j-dependencies +
                quarkus-bom + 轨道 override）。parent 继承即获得 quarkus-* / easyexcel /
                jakarta-* 等全部第三方版本，业务项目无需再自行 import BOM。
            -->
            <dependency>
                <groupId>io.ddd4j.quarkus</groupId>
                <artifactId>ddd4j-quarkus-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- ddd4j-quarkus-bom：本仓 io.ddd4j / io.ddd4j.quarkus 模块坐标统一版本 -->
            <dependency>
                <groupId>io.ddd4j.quarkus</groupId>
                <artifactId>ddd4j-quarkus-bom</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web / REST：
             quarkus-rest (RESTEasy Reactive) 与 quarkus-resteasy (经典) 在 Quarkus 3 中互斥。
             parent 仅引入 quarkus-arc，REST 实现由子项目按需显式声明其一：
               - 新项目（推荐）：在 pom.xml 中添加 quarkus-rest + quarkus-rest-jackson
               - 遗留项目：在 pom.xml 中添加 quarkus-resteasy + quarkus-resteasy-jackson
             parent 提供 legacy-resteasy profile，启用后自动注入经典 resteasy（通过 -Plegacy-resteasy）。 -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>

        <!--
            业务选型依赖（数据层/调度/JWT/容错/API 文档/Excel 等）不在此处默认提供——
            parent 不应替下游项目确定技术选型。需要时通过 profile 显式激活
            （版本由 ddd4j-quarkus-dependencies 管理，无需声明 version）：
              -Pddd4j-web      API 文档 + JWT + 容错 + 健康检查
              -Pddd4j-data     Panache ORM + 事务 + MySQL 驱动
              -Pddd4j-schedule Quartz 调度
              -Pddd4j-excel    EasyExcel
              -Pddd4j-full     上述全部 + ddd4j-runtime-quarkus/cache/data-panache/ddd
            或者在下游项目 pom 中直接声明所需依赖（推荐，选型更明确）。
        -->

        <!-- Jakarta API -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            JUnit 4（test）：Quarkus Dev Services 处理器（如 MySQLDevServicesProcessor）
            加载时引用 org.junit.rules.TestRule（junit4），Quarkus 3 仅传递 junit-jupiter，
            缺 junit4 会导致 @QuarkusTest 构建阶段 NoClassDefFoundError。
            版本由 ddd4j 仓库统一管理（4.13.2）。
        -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            经典 RESTEasy 兼容性 profile：业务项目使用经典 JAX-RS (quarkus-resteasy) 时启用。
            启用方式：mvn -Plegacy-resteasy ...（依赖即被注入到当前项目依赖图）
            新项目（推荐）使用 quarkus-rest，无需此 profile。
        -->
        <profile>
            <id>legacy-resteasy</id>
            <dependencies>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-resteasy</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-resteasy-jackson</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!--
            按域选型 profile：parent 不默认提供业务选型依赖，由业务项目按需激活。
            每个 profile 引入一组完整的业务技术栈；也可不激活任何 profile，
            直接在下游项目 pom 中声明所需依赖（选型最明确）。
            所有依赖版本由 ddd4j-quarkus-dependencies（quarkus-bom + ddd4j-dependencies）管理。
        -->

        <!-- Web 域：API 文档 + JWT + 容错 + 健康检查（REST 实现仍由业务项目显式声明 quarkus-rest / quarkus-resteasy） -->
        <profile>
            <id>ddd4j-web</id>
            <dependencies>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-smallrye-openapi</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-smallrye-jwt</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-smallrye-health</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!-- 数据域：Panache ORM + JTA 事务 + MySQL 驱动 -->
        <profile>
            <id>ddd4j-data</id>
            <dependencies>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-hibernate-orm-panache</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-narayana-jta</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-jdbc-mysql</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!-- 调度域：Quartz -->
        <profile>
            <id>ddd4j-schedule</id>
            <dependencies>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-quartz</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!-- 业务通用：EasyExcel 导入导出 -->
        <profile>
            <id>ddd4j-excel</id>
            <dependencies>
                <dependency>
                    <groupId>com.alibaba</groupId>
                    <artifactId>easyexcel</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!--
            ddd4j-full profile：一键引入 ddd4j Quarkus 轨道推荐完整组合（= ddd4j-web + ddd4j-data
            + ddd4j-schedule + ddd4j-excel 全部业务选型依赖 + ddd4j 运行时/缓存/数据/DDD 模块），
            开箱即用 ddd4j 能力。本仓定位对齐 ddd4j-boot：作为 Quarkus 深度适配聚合层，
            核心运行时收敛到 io.ddd4j:ddd4j-runtime-quarkus，本仓保留 ddd/auth/data/mq/cache 等模块边界。
            启用方式：mvn -Pddd4j-full ... 或在业务项目 <activation> 中默认启用。

            引入的推荐组合：
              - Web/数据/调度/Excel 选型依赖（同 ddd4j-web / ddd4j-data / ddd4j-schedule / ddd4j-excel）
              - ddd4j-runtime-quarkus      : DDD 构造型注解 + 核心 SPI（Subject/I18n/DomainEvent）CDI 桥接
              - ddd4j-quarkus-cache        : Caffeine/Guava/Hutool 本地缓存（Quarkus BuildStep + Recorder）
              - ddd4j-quarkus-data-panache : 多租户 Panache 实体基类 + 查询构建 + ID 生成
              - ddd4j-quarkus-ddd          : Quartz 视图调度 + JPA 投影 + EventStore 配置
              - Web 模块已迁入主仓 io.ddd4j:ddd4j-web-quarkus（不再由本仓 profile 自动引入）

            需要额外能力（MQ/Auth/Extensions）时，业务项目按需在自身 dependencies 中追加对应模块。
            版本由 ddd4j-quarkus-bom / ddd4j-quarkus-dependencies 统一管理，无需在此声明 version。
        -->
        <profile>
            <id>ddd4j-full</id>
            <dependencies>
                <!-- Web 域 -->
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-smallrye-openapi</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-smallrye-jwt</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-smallrye-health</artifactId>
                </dependency>
                <!-- 数据域 -->
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-hibernate-orm-panache</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-narayana-jta</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-jdbc-mysql</artifactId>
                </dependency>
                <!-- 调度域 -->
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-quartz</artifactId>
                </dependency>
                <!-- 业务通用 -->
                <dependency>
                    <groupId>com.alibaba</groupId>
                    <artifactId>easyexcel</artifactId>
                </dependency>
                <!-- ddd4j 模块 -->
                <dependency>
                    <groupId>io.ddd4j</groupId>
                    <artifactId>ddd4j-runtime-quarkus</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.ddd4j.quarkus</groupId>
                    <artifactId>ddd4j-quarkus-cache</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.ddd4j.quarkus</groupId>
                    <artifactId>ddd4j-quarkus-data-panache</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.ddd4j.quarkus</groupId>
                    <artifactId>ddd4j-quarkus-ddd</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    ddd4j-quarkus-parent 的 pluginManagement 仅声明 Quarkus 轨道独有的 plugin。
                    其余核心插件（maven-compiler / enforcer / surefire / failsafe / source / jar /
                    resources / install / deploy / flatten / git-commit-id / docker 等）的版本与基础
                    配置已由 ddd4j-parent 的 pluginManagement 统一管理，Quarkus 业务项目继承本 parent
                    时自动获得，无需在此重复声明。
                -->

                <!-- Quarkus 构建：生成代码 + 打包 + 测试代码生成。
                     通过 quarkus.build.skip 属性控制是否执行 build goal（默认 false，业务项目正常构建）。
                     示例项目（ddd4j-quarkus-samples）覆盖为 true，跳过 Hibernate 增强步骤。 -->
                <plugin>
                    <groupId>io.quarkus.platform</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus-bom.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <skip>${quarkus.build.skip}</skip>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>build</goal>
                                <goal>generate-code</goal>
                                <goal>generate-code-tests</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- 编译：release + -parameters（覆盖 ddd4j-parent 的 source/target，使用 release） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <!-- Unit Test：JVM LogManager 切到 JBoss，避免与 Quarkus 日志桥接冲突 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>

                <!-- Integration Test：JBoss LogManager -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>

                <!-- Docker 镜像构建：仅保留 skip 默认值；registry / buildx / 平台由业务项目配置 -->
                <plugin>
                    <groupId>io.fabric8</groupId>
                    <artifactId>docker-maven-plugin</artifactId>
                    <configuration>
                        <skip>${docker.skip}</skip>
                        <skipPush>${docker.push.skip}</skipPush>
                        <images>
                            <image>
                                <name>
                                    ${docker.registry.host:registry.ddd4j.io}/${project.artifactId}:${project.version}
                                </name>
                                <build>
                                    <dockerFile>${project.basedir}/Dockerfile</dockerFile>
                                </build>
                            </image>
                        </images>
                    </configuration>
                    <executions>
                        <execution>
                            <id>build</id>
                            <phase>install</phase>
                            <goals>
                                <goal>build</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>push</id>
                            <phase>deploy</phase>
                            <goals>
                                <goal>push</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
