<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-extensions</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-extension-cola</artifactId>
    <description>ddd4j-quarkus COLA 扩展适配：基于 com.alibaba.cola 组件 + ddd4j-core 统一响应契约的异常处理/响应包装（自包含，不依赖上游 ddd4j-ddd-cola——其已在主仓 3.0.x 移除）。</description>

    <dependencies>
        <!-- ddd4j-ddd-cola（2.0.x 上游）已在主仓 3.0.x 移除；本模块源码仅用
             com.alibaba.cola 组件 + io.ddd4j:ddd4j-core 契约，自包含。 -->
        <!-- For ddd4j-core: 统一响应模型（ApiRestResponse / ApiCode） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!-- For Alibaba COLA（版本由 ddd4j-dependencies 引入的 cola-components-bom 管理） -->
        <dependency>
            <groupId>com.alibaba.cola</groupId>
            <artifactId>cola-component-dto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cola</groupId>
            <artifactId>cola-component-exception</artifactId>
        </dependency>
        <!-- ResponseHandlerI 所在；COLA starter 传递 Spring Boot，Quarkus 轨必须排除 -->
        <dependency>
            <groupId>com.alibaba.cola</groupId>
            <artifactId>cola-component-catchlog-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-autoconfigure</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- JAX-RS：ColaExceptionHandler/ColaSysExceptionHandler 实现 jakarta.ws.rs.ext.ExceptionMapper
             （框架模块不继承 quarkus-parent 的默认 jakarta 依赖，需显式声明） -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
    </dependencies>
</project>
