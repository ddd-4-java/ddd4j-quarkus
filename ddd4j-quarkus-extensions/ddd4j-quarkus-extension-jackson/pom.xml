<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-extensions</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-extension-jackson</artifactId>
    <description>ddd4j-quarkus Jackson 扩展适配：对齐 boot 模块结构，底层复用 io.github.easy4j:jackson-extension（JavaTimeModule / MyBeanSerializerModifier），通过 Quarkus ObjectMapperCustomizer 定制 ObjectMapper。</description>

    <dependencies>
        <!-- 权威实现：io.github.easy4j:jackson-extension（boot ddd4j-boot-extension-jackson 同款依赖）。
             显式钉住 3.0.x.20260630-SNAPSHOT：该第三方制品在 snapshot 仓库没有跟随
             ddd4j.version(3.0.x.20260730) 发布 3.0.x.20260730 版本线，按 ${ddd4j.version} 解析必然缺失 -->
        <dependency>
            <groupId>io.github.easy4j</groupId>
            <artifactId>jackson-extension</artifactId>
            <version>3.0.x.20260630-SNAPSHOT</version>
        </dependency>
        <!-- Quarkus Jackson：提供 ObjectMapper + io.quarkus.jackson.ObjectMapperCustomizer 定制接口 -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
    </dependencies>
</project>
