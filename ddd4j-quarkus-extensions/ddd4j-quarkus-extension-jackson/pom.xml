<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-extensions</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-extension-jackson</artifactId>
    <description>ddd4j-quarkus Jackson 扩展适配：对齐 boot 模块结构，null 容错序列化采用自包含的 NullTolerantBeanSerializerModifier；easy4j Jackson 扩展坐标由 ddd4j 3.0.x BOM 管理，通过 Quarkus ObjectMapperCustomizer 定制 ObjectMapper。</description>

    <dependencies>
        <!-- ddd4j 3.0.x BOM 统一管理 easy4j Jackson 扩展版本；叶子模块不得重复钉版。 -->
        <dependency>
            <groupId>io.github.easy4j</groupId>
            <artifactId>jackson-extension</artifactId>
        </dependency>
        <!-- Quarkus Jackson：提供 ObjectMapper + io.quarkus.jackson.ObjectMapperCustomizer 定制接口 -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
    </dependencies>
</project>
