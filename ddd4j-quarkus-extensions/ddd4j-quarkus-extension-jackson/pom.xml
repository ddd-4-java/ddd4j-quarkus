<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-extensions</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-extension-jackson</artifactId>
    <description>ddd4j-quarkus Jackson 扩展适配：对齐 boot 模块结构，底层复用 io.github.hiwepy:jackson-extension（JavaTimeModule / MyBeanSerializerModifier），通过 Quarkus ObjectMapperCustomizer 定制 ObjectMapper。</description>

    <dependencies>
        <!-- 权威实现：io.github.hiwepy:jackson-extension（boot ddd4j-boot-extension-jackson 同款依赖） -->
        <dependency>
            <groupId>io.github.hiwepy</groupId>
            <artifactId>jackson-extension</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!-- Quarkus Jackson：提供 ObjectMapper + io.quarkus.jackson.ObjectMapperCustomizer 定制接口 -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
    </dependencies>
</project>
