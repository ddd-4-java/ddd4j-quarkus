<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-quarkus-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-extensions</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j-quarkus 跨领域扩展聚合。
        对齐 ddd4j-boot-extensions 的扩展边界，按 Quarkus 原生能力承载 cola、monitor 等扩展适配。
    </description>

    <subprojects>
        <subproject>ddd4j-quarkus-extension-akka</subproject>
        <subproject>ddd4j-quarkus-extension-cola</subproject>
        <subproject>ddd4j-quarkus-extension-dubbo</subproject>
        <subproject>ddd4j-quarkus-extension-excel</subproject>
        <subproject>ddd4j-quarkus-extension-jackson</subproject>
        <subproject>ddd4j-quarkus-extension-monitor</subproject>
        <subproject>ddd4j-quarkus-extension-qlexpress</subproject>
        <subproject>ddd4j-quarkus-extension-qrcode</subproject>
        <subproject>ddd4j-quarkus-extension-validation</subproject>
    </subprojects>

    <build>
        <plugins>
            <!--
                Jandex 索引（所有扩展模块继承）：扩展的 @ConfigMapping 接口（如
                JacksonConfig/QLExpressConfig/DubboConfig 等）由 Quarkus 的 SmallRye
                Config 处理器从 Jandex 索引发现；@QuarkusTest 时 Quarkus bootstrap 从
                本地仓库解析扩展 jar，无 jandex.idx 则报
                "SRCFG00027: Could not find a mapping for XxxConfig"。
            -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
