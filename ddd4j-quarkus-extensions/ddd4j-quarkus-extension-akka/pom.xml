<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-extensions</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-extension-akka</artifactId>
    <description>ddd4j-quarkus Akka 扩展适配：ActorSystem/Extension CDI 装配，直接基于 Akka 原生 API（自包含，不依赖上游 ddd4j-extension-akka——其已在主仓 3.0.x 迁至 ddd4j-boot）。</description>

    <dependencies>
        <!-- ddd4j-extension-akka（2.0.x 上游）已在主仓 3.0.x 迁至 ddd4j-boot（Spring 轨）；
             本模块源码仅用 Akka 原生 API（akka-actor/akka-slf4j）+ 自有 CDI 装配，自包含。 -->
        <!-- For Akka（版本由 ddd4j-dependencies 统一管理） -->
        <dependency>
            <groupId>com.typesafe.akka</groupId>
            <artifactId>akka-actor_3</artifactId>
        </dependency>
        <dependency>
            <groupId>com.typesafe.akka</groupId>
            <artifactId>akka-slf4j_3</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
    </dependencies>
</project>
