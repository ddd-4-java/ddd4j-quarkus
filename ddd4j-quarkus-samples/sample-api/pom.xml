<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../ddd4j-quarkus-parent/pom.xml</relativePath>
    </parent>

    <artifactId>sample-api</artifactId>
    <description>ddd4j-quarkus 最小可运行示例：REST + Health + uber-jar</description>

    <properties>
        <quarkus.package.jar.type>uber-jar</quarkus.package.jar.type>
    </properties>

    <dependencies>
        <!-- 业务演示：演示 ddd4j-quarkus-core 的 RequestContext + ddd4j-core 的 R 统一响应 -->
        <dependency>
            <groupId>io.ddd4j.quarkus</groupId>
            <artifactId>ddd4j-quarkus-core</artifactId>
        </dependency>
        <!-- REST 实现：Quarkus 3 默认使用 quarkus-rest（与 resteasy 互斥） -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 激活 parent pluginManagement 中声明的 build/generate-code/generate-code-tests goals -->
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
