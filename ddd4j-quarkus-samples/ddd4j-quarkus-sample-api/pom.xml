<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../ddd4j-quarkus-parent/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-sample-api</artifactId>
    <description>ddd4j-quarkus 最小可运行示例：REST + Health + uber-jar</description>

    <properties>
        <quarkus.package.jar.type>uber-jar</quarkus.package.jar.type>
        <!-- 跳过 quarkus build（Hibernate 兼容问题），仅编译打包 jar。
             parent 默认 quarkus.build.skip=false，示例项目覆盖为 true。 -->
        <quarkus.build.skip>true</quarkus.build.skip>
    </properties>

    <dependencies>
        <!-- 业务演示：演示 io.ddd4j:ddd4j-quarkus 的 Quarkus 核心适配 + ddd4j-core 的 R 统一响应 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-quarkus</artifactId>
        </dependency>
        <!-- REST 实现：Quarkus 3 默认使用 quarkus-rest（与 resteasy 互斥） -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 激活 parent pluginManagement 中声明的 build/generate-code/generate-code-tests goals。
                 skip 由 quarkus.build.skip 属性控制（本模块覆盖为 true）。 -->
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
