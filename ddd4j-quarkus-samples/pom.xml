<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>ddd4j-quarkus-samples</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j-quarkus 示例聚合。示例项目继承 ddd4j-quarkus-parent（含 Panache 等数据层默认依赖），
        但仅用于演示代码结构与 API 用法，不需构建为可运行 uber-jar。
        通过 quarkus.build.skip=true 属性统一跳过 quarkus-maven-plugin 的 build goal
        （历史遗留：Quarkus 轨道曾因 Hibernate ORM 6.6.x 的 BootLogging.BOOT_LOGGER 字段不兼容导致 build 失败，
        现 dependencies 已显式管理 Hibernate 7.4.1；skip 保留以加速示例构建）。
        真实业务项目（如 cloud-das）不受影响，默认 quarkus.build.skip=false。
    </description>
    <modules>
        <!-- DDD 分层架构示例骨架：对齐 ddd4j-boot-samples 的通用分层结构，Quarkus 侧按需补实现 -->
        <module>ddd4j-quarkus-sample-layered</module>
        <module>ddd4j-quarkus-sample-domain</module>
        <module>ddd4j-quarkus-sample-adapter</module>
        <module>ddd4j-quarkus-sample-client</module>
        <module>ddd4j-quarkus-sample-app</module>
        <module>ddd4j-quarkus-sample-infrastructure</module>
        <module>ddd4j-quarkus-sample-common</module>
        <module>ddd4j-quarkus-sample-api</module>
        <!-- CQRS 业务链路示例：JAX-RS 命令入口 + CDI 投影 + Scheduler 增量刷新 -->
        <!-- 普通充血模型示例：AggregateRoot + DomainRepository + Model/PO 分离 -->
        <!-- Auth 鉴权示例：演示 SubjectKit 统一鉴权入口（JAX-RS 端点） -->
        <module>ddd4j-quarkus-sample-auth-satoken</module>
        <module>ddd4j-quarkus-sample-auth-security</module>
        <module>ddd4j-quarkus-sample-auth-shiro</module>
        <!-- MQ 集成示例：业务发布 DomainEvent → MQ 投递 → @MQEventListener 消费，三套实现互为对照 -->
        <module>ddd4j-quarkus-sample-mq-disruptor</module>
        <module>ddd4j-quarkus-sample-mq-kafka</module>
        <module>ddd4j-quarkus-sample-mq-rabbitmq</module>
    </modules>

    <properties>
        <!-- 示例项目统一跳过 quarkus build（仅编译打包 jar），子模块继承此属性 -->
        <quarkus.build.skip>true</quarkus.build.skip>
    </properties>

    <dependencyManagement>
        <!--
            import ddd4j-quarkus-dependencies（含 quarkus-bom 3.38.2 + 轨道覆盖）：
            samples 直接继承 ddd4j-quarkus 根 POM（其父为 ddd4j 主仓 ddd4j-parent，
            带主仓 quarkus-bom 的依赖管理，如 agroal-api 2.0）。
            此处显式 import 使 quarkus 3.38.2 轨道版本（如 agroal-api 3.2，
            含 MultipleAcquisitionAction.LENIENT）在层级上覆盖主仓管理，避免
            @QuarkusTest 启动时 "Cannot convert lenient" 配置转换失败。
        -->
        <dependencies>
            <dependency>
                <groupId>io.ddd4j.quarkus</groupId>
                <artifactId>ddd4j-quarkus-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            JUnit 4（test）：Quarkus Dev Services 处理器（quarkus-devservices-h2/mysql 等）
            加载时引用 org.junit.rules.TestRule（junit4），Quarkus 3 仅传递 junit-jupiter，
            缺 junit4 会导致 @QuarkusTest 构建阶段 NoClassDefFoundError。
            版本由 ddd4j 仓库统一管理（4.13.2）。
        -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
