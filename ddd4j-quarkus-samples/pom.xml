<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>ddd4j-quarkus-samples</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j-quarkus 示例聚合。示例项目继承 ddd4j-quarkus-parent（含 Panache 等数据层默认依赖），
        但仅用于演示代码结构与 API 用法，不需构建为可运行 uber-jar。
        通过 quarkus.build.skip=true 属性统一跳过 quarkus-maven-plugin 的 build goal
        （Quarkus 3.36.3 + Hibernate ORM 6.6.40 存在 BootLogging.BOOT_LOGGER 字段不兼容）。
        真实业务项目（如 cloud-das）不受影响，默认 quarkus.build.skip=false。
    </description>
    <modules>
        <!-- DDD 分层架构示例骨架：对齐 ddd4j-boot-samples 的通用分层结构，Quarkus 侧按需补实现 -->
        <module>ddd4j-quarkus-sample-layered</module>
        <module>ddd4j-quarkus-sample-domain</module>
        <module>ddd4j-quarkus-sample-adapter</module>
        <module>ddd4j-quarkus-sample-client</module>
        <module>ddd4j-quarkus-sample-app</module>
        <module>ddd4j-quarkus-sample-infrastructure</module>
        <module>ddd4j-quarkus-sample-common</module>
        <module>ddd4j-quarkus-sample-api</module>
        <!-- CQRS 业务链路示例：JAX-RS 命令入口 + CDI 投影 + Scheduler 增量刷新 -->
        <module>ddd4j-quarkus-sample-cqrs-person</module>
        <!-- 普通充血模型示例：AggregateRoot + DomainRepository + Model/PO 分离 -->
        <module>ddd4j-quarkus-sample-rich-model</module>
        <!-- Auth 鉴权示例：演示 SubjectKit 统一鉴权入口（JAX-RS 端点） -->
        <module>ddd4j-quarkus-sample-auth-satoken</module>
        <module>ddd4j-quarkus-sample-auth-security</module>
        <module>ddd4j-quarkus-sample-auth-shiro</module>
    </modules>

    <properties>
        <!-- 示例项目统一跳过 quarkus build（仅编译打包 jar），子模块继承此属性 -->
        <quarkus.build.skip>true</quarkus.build.skip>
    </properties>
</project>
