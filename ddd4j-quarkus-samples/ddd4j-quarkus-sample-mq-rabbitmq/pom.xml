<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-samples</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ddd4j-quarkus-sample-mq-rabbitmq</artifactId>
    <description>ddd4j-quarkus RabbitMQ MQ 示例：业务发布 DomainEvent → RabbitMQ 投递（AMQP Topic Exchange） → @MQEventListener 消费</description>

    <dependencies>
        <!-- ddd4j 核心与注解 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-annotation</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-kit</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>

        <!-- ddd4j Quarkus 运行时绑定 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-runtime-quarkus</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>

        <!-- ddd4j Web (Quarkus 集成) -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-web-quarkus</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>

        <!-- ddd4j MQ 核心 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-mq-core</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>

        <!--
            ddd4j-quarkus-mq-rabbitmq：RabbitMQ 适配的 Quarkus CDI 桥接模块。
            底层复用 ddd4j-mq-rabbitmq（基于 amqp-client + ddd4j MQ SPI）。
            该模块已包含 RabbitMQCdiProducer，自动提供：
              - RabbitMQProperties
              - RabbitMQBrokerAdapter（@DefaultBean）
              - MQEventPublisher（@DefaultBean）
            业务代码无需关心连接 / Channel / Exchange / Queue 生命周期。
            切换 Kafka / Disruptor 时只需替换此依赖，业务代码完全无需修改。
        -->
        <dependency>
            <groupId>io.ddd4j.quarkus</groupId>
            <artifactId>ddd4j-quarkus-mq-rabbitmq</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Quarkus RESTEasy Reactive -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>