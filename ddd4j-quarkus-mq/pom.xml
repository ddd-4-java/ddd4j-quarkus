<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-quarkus-dependencies/pom.xml</relativePath>
    </parent>
    <artifactId>ddd4j-quarkus-mq</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j 消息队列在 Quarkus 轨道的桥接聚合。
        参照 ddd4j-mq 多模块范式：
        - core（MQ 契约 + CDI 桥接）
        - activemq / disruptor / kafka / mqtt / mqtt-mica / sqs / nats / ons / pulsar / rabbitmq / redis-stream / rocketmq / tdmq
        对齐 ddd4j-boot-mq 的模块边界；底层优先复用 io.ddd4j:ddd4j-mq-* 纯 Java 能力，Quarkus 侧承载 CDI 与依赖编排。
        tdmq 当前复用 MQ core 作为 Quarkus 侧扩展入口，避免引入 Spring Boot 自动配置。
    </description>

    <subprojects>
        <subproject>ddd4j-quarkus-mq-core</subproject>
        <subproject>ddd4j-quarkus-mq-activemq</subproject>
        <subproject>ddd4j-quarkus-mq-disruptor</subproject>
        <subproject>ddd4j-quarkus-mq-kafka</subproject>
        <subproject>ddd4j-quarkus-mq-mqtt</subproject>
        <subproject>ddd4j-quarkus-mq-mqtt-mica</subproject>
        <subproject>ddd4j-quarkus-mq-sqs</subproject>
        <subproject>ddd4j-quarkus-mq-nats</subproject>
        <subproject>ddd4j-quarkus-mq-ons</subproject>
        <subproject>ddd4j-quarkus-mq-pulsar</subproject>
        <subproject>ddd4j-quarkus-mq-rabbitmq</subproject>
        <subproject>ddd4j-quarkus-mq-redis-stream</subproject>
        <subproject>ddd4j-quarkus-mq-rocketmq</subproject>
        <subproject>ddd4j-quarkus-mq-tdmq</subproject>
        <subproject>ddd4j-quarkus-mq-testcontainers</subproject>
    </subprojects>

</project>
