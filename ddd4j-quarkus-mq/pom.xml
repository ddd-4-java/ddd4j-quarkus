<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-quarkus-parent/pom.xml</relativePath>
    </parent>
    <artifactId>ddd4j-quarkus-mq</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j 消息队列在 Quarkus 轨道的桥接聚合。
        参照 ddd4j-mq 多模块范式：
        - core（MQ 契约 + CDI 桥接）
        - disruptor / sqs / nats / ons（无 Spring 强耦合的 broker，可直接复用）
        强 Spring 耦合的 broker（kafka/rabbitmq/rocketmq/pulsar/redis-stream/mqtt/activemq）
        不直接提供，业务项目通过 SmallRye Reactive Messaging 自行适配。
    </description>

    <modules>
        <module>ddd4j-quarkus-mq-core</module>
        <module>ddd4j-quarkus-mq-disruptor</module>
        <module>ddd4j-quarkus-mq-sqs</module>
        <module>ddd4j-quarkus-mq-nats</module>
        <module>ddd4j-quarkus-mq-ons</module>
    </modules>

</project>
