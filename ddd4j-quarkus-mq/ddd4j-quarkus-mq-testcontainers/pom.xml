<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://mvn.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../ddd4j-quarkus-parent/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-mq-testcontainers</artifactId>
    <packaging>jar</packaging>
    <description>
        ddd4j-quarkus 消息队列 testcontainers 共享 fixture：
        - AbstractTestContainerFixture（统一 start/stop + withReuse）
        - 13 个 broker 的专用 fixture（Kafka / RabbitMQ / RocketMQ / ActiveMQ / Pulsar / NATS /
          MQTT / Redis-Stream / SQS / ONS / TDMQ / Disruptor / MQTT-Mica）
        - QuarkusResourceLifecycleManager 集成（每个 fixture 自动注入容器连接信息到 application.properties）
        - JunitJupiterQuarkusTestContainers 注解 + Ddd4jQuarkusTestContainersExtension（Docker 守护优雅跳过）
        - AbstractMqQuarkusIntegrationTest（publish → broker → @MQEventListener round-trip 骨架）

        镜像版本统一固定为（与 ddd4j-boot 镜像清单一致）：
        - kafka:7.7.2 (confluentinc/cp-kafka, KRaft 模式)
        - rabbitmq:3.13-management-alpine
        - rocketmq:5.3.2 (apache/rocketmq, namesrv+broker 单容器双进程)
        - activemq-artemis:2.33.0-alpine (主仓 ddd4j-mq-activemq 客户端为 artemis-jakarta-client,
          CORE 协议 61616；classic OpenWire 不兼容)
        - pulsar:3.2.0 (apachepulsar/pulsar, standalone)
        - nats:2.10.22
        - mqtt:2.0 (eclipse-mosquitto)
        - redis:7.4-alpine (启用 notify-keyspace-events)
        - localstack:3.8.0 (SQS)
        - disruptor: 无容器，本地内存
    </description>

    <dependencies>
        <!-- 核心 testcontainers API -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
        </dependency>
        <!-- 专用 broker 容器（testcontainers 子模块，1.20+ 各 broker 拆分为独立 artifact） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
        </dependency>
        <!-- Quarkus test 集成（含 QuarkusTestResourceLifecycleManager） -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
        </dependency>
        <!--
            JUnit 4（compile）：GenericContainer#withReuse(true) 的方法签名/类型层次
            引用 org.junit.rules.TestRule（testcontainers 内部），fixture 在 main scope，
            需 junit4 编译期可用（版本由 ddd4j 仓库统一管理 4.13.2）。
        -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
        <!--
            JUnit 5 集成（compile）：JunitJupiterQuarkusTestContainers 注解 +
            Ddd4jQuarkusTestContainersExtension（ExecutionCondition）在 main scope，
            AbstractMqQuarkusIntegrationTest 的 await/断言也引用 junit-jupiter-api。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <!--
            MQ 契约（compile）：AbstractMqQuarkusIntegrationTest round-trip 骨架引用
            MQClient / MQProperties / MQEvent / MQListener（版本由父 pom ddd4j.version 管理）。
        -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-mq-core</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!-- awaitility 用于异步断言 -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency></dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>