<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://mvn.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ddd4j-quarkus-mq-testcontainers</artifactId>
    <packaging>jar</packaging>
    <description>
        ddd4j-quarkus 消息队列 testcontainers 共享 fixture：
        - AbstractTestContainerFixture（统一 start/stop，自有容器确定性关闭）
        - 13 个 broker 的专用 fixture（Kafka / RabbitMQ / RocketMQ / ActiveMQ / Pulsar / NATS /
          MQTT / Redis-Stream / SQS / ONS / TDMQ / Disruptor / MQTT-Mica）
        - QuarkusResourceLifecycleManager 集成（每个 fixture 自动注入容器连接信息到 application.properties）
        - JunitJupiterQuarkusTestContainers 注解 + Ddd4jQuarkusTestContainersExtension（Docker 守护优雅跳过）
        - AbstractMqQuarkusIntegrationTest（publish → broker → @MQEventListener round-trip 骨架）

        镜像版本统一固定为（与 ddd4j-boot 镜像清单一致）：
        - kafka:7.7.2 (confluentinc/cp-kafka, KRaft 模式)
        - rabbitmq:3.13-management-alpine
        - rocketmq:5.3.2 (apache/rocketmq, namesrv+broker 单容器双进程)
        - activemq-artemis:2.33.0-alpine (主仓 ddd4j-mq-activemq 客户端为 artemis-jakarta-client,
          CORE 协议 61616；classic OpenWire 不兼容)
        - pulsar:3.2.0 (apachepulsar/pulsar, standalone)
        - nats:2.10.22
        - mqtt:2.0 (eclipse-mosquitto)
        - redis:7.4-alpine (启用 notify-keyspace-events)
        - localstack:3.8.0 (SQS)
        - disruptor: 无容器，本地内存
    </description>

    <dependencies>
        <!-- 真实 JetStream stream 初始化，由本仓 dependencies 统一管理版本。 -->
        <dependency>
            <groupId>io.nats</groupId>
            <artifactId>jnats</artifactId>
        </dependency>
        <!-- 核心 testcontainers API -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
        </dependency>
        <!-- Testcontainers 2.x 官方专用 broker 容器模块。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-activemq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-localstack</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-pulsar</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
        </dependency>
        <!-- Quarkus test 集成（含 QuarkusTestResourceLifecycleManager） -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
        </dependency>
        <!--
            JUnit 5 集成（compile）：JunitJupiterQuarkusTestContainers 注解 +
            Ddd4jQuarkusTestContainersExtension（ExecutionCondition）在 main scope，
            AbstractMqQuarkusIntegrationTest 的 await/断言也引用 junit-jupiter-api。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
        </dependency>
        <!--
            MQ 契约（compile）：AbstractMqQuarkusIntegrationTest round-trip 骨架引用
            MQClient / MQProperties / MQEvent / MQListener（版本由父 pom ddd4j.version 管理）。
        -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-mq-core</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!-- awaitility 用于异步断言 -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency></dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
            <!-- 测试期间通过反射读取 Testcontainers 内部字段（WaitAllStrategy.strategies /
                 LogMessageWaitStrategy.regEx / HttpWaitStrategy.path 等），Java 16+ 强封装
                 默认拒绝 setAccessible；必须显式 add opens 对应模块包。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        @{argLine}
                        --add-opens org.testcontainers/org.testcontainers.containers=ALL-UNNAMED
                        --add-opens org.testcontainers/org.testcontainers.containers.wait.strategy=ALL-UNNAMED
                        --add-opens org.testcontainers.pulsar/org.testcontainers.pulsar=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
