            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.langchain4j/quarkus-langchain4j-bom -->
            <dependency>
                <groupId>io.quarkiverse.langchain4j</groupId>
                <artifactId>quarkus-langchain4j-bom</artifactId>
                <version>${quarkus-langchain4j-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.mcp/quarkus-mcp-server-bom -->
            <dependency>
                <groupId>io.quarkiverse.mcp</groupId>
                <artifactId>quarkus-mcp-server-bom</artifactId>
                <version>${quarkus-mcp-server-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.openid-ssf/quarkus-openid-ssf-bom -->
            <dependency>
                <groupId>io.quarkiverse.openid-ssf</groupId>
                <artifactId>quarkus-openid-ssf-bom</artifactId>
                <version>${quarkus-openid-ssf-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.operatorsdk/quarkus-operator-sdk-bom -->
            <dependency>
                <groupId>io.quarkiverse.operatorsdk</groupId>
                <artifactId>quarkus-operator-sdk-bom</artifactId>
                <version>${quarkus-operator-sdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.vault/quarkus-vault-bom -->
            <dependency>
                <groupId>io.quarkiverse.vault</groupId>
                <artifactId>quarkus-vault-bom</artifactId>
                <version>${quarkus-vault-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.xmlsec/quarkus-xmlsec-bom -->
            <dependency>
                <groupId>io.quarkiverse.xmlsec</groupId>
                <artifactId>quarkus-xmlsec-bom</artifactId>
                <version>${quarkus-xmlsec-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 4. ddd4j 平台核心模块坐标（纯 Java，零 Spring 依赖）。
                 显式声明 io.ddd4j:* 全部常用模块版本，避免 ddd4j-quarkus 子模块
                 必须依赖 ddd4j-quarkus-bom 才能解析版本。 -->
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-core</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <!-- Published ddd4j BOM contains literal Testcontainers versions; keep only used modules aligned. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers-bom.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-activemq</artifactId>
                <version>${testcontainers-bom.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-junit-jupiter</artifactId>
                <version>${testcontainers-bom.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-kafka</artifactId>
                <version>${testcontainers-bom.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-localstack</artifactId>
                <version>${testcontainers-bom.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-mysql</artifactId>
                <version>${testcontainers-bom.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-pulsar</artifactId>
                <version>${testcontainers-bom.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-postgresql</artifactId>
                <version>${testcontainers-bom.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-rabbitmq</artifactId>
                <version>${testcontainers-bom.version}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-kit</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-annotation</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-cache</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <!-- 已验证的 ddd4j-extension-license 2.0.x 发布 POM 只声明 ddd4j-cache，
                 未传递 TrueLicense；为本仓 License 适配器保留直接兼容依赖的 1.33 版本管理。 -->
            <dependency>
                <groupId>de.schlichtherle.truelicense</groupId>
                <artifactId>truelicense-core</artifactId>
                <version>1.33</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-runtime-quarkus</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-web-quarkus</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-extension-license</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <!-- 4.1 本仓 ddd4j-quarkus-* 模块统一版本管理。
                 ddd4j-quarkus-bom 也声明了这些，但部分聚合子模块（如 ddd4j-quarkus-mq）
                 没有 import bom，需要在 dependencies 顶层提供，避免子模块版本解析失败。 -->
            <dependency>
                <groupId>io.ddd4j.quarkus</groupId>
                <artifactId>ddd4j-quarkus-mq-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.quarkus</groupId>
                <artifactId>ddd4j-quarkus-mq-testcontainers</artifactId>
                <version>${revision}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>
    <!--
        框架模块公共测试依赖（继承本 POM 的模块：mq/extensions/auth/data/cache/ddd/web）：
        @QuarkusTest 需要 quarkus-junit；HTTP 断言用 rest-assured；断言用 assertj；
        junit4 供 Quarkus Dev Services 处理器加载（TestRule）。业务项目父 POM
        （ddd4j-quarkus-parent）同样提供这些依赖并覆盖插件配置，不受影响。
    -->
    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- assertj：框架模块测试断言（data-panache/cache/auth-jwt 等的 *Test 使用），
             版本由 quarkus-bom 管理。缺失会导致继承模块测试编译失败。 -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>



    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <failOnError>true</failOnError>
                    <failOnWarnings>false</failOnWarnings>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <configuration>
                            <failOnError>true</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <!-- Quarkus 构建（模块显式声明时生效，如 mq-testcontainers） -->
                <plugin>
                    <groupId>io.quarkus.platform</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus-bom.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <skip>${quarkus.build.skip}</skip>
                    </configuration>
                </plugin>
                <!-- 编译：release + -parameters（覆盖 ddd4j-parent 的 source/target） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <!-- Unit Test：JVM LogManager 切到 JBoss，避免与 Quarkus 日志桥接冲突 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <!-- Integration Test：JBoss LogManager -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
