        <quarkus-jgit-bom.version>3.6.2</quarkus-jgit-bom.version>
        <quarkus-jpastreamer-bom.version>3.0.3.Final</quarkus-jpastreamer-bom.version>
        <quarkus-kafka-streams-processor-bom.version>6.0.7</quarkus-kafka-streams-processor-bom.version>
        <quarkus-langchain4j-bom.version>1.12.0</quarkus-langchain4j-bom.version>
        <quarkus-mcp-server-bom.version>1.13.1</quarkus-mcp-server-bom.version>
        <quarkus-openid-ssf-bom.version>0.0.3</quarkus-openid-ssf-bom.version>
        <quarkus-operator-sdk-bom.version>7.7.5</quarkus-operator-sdk-bom.version>
        <quarkus-vault-bom.version>4.8.0</quarkus-vault-bom.version>
        <quarkus-xmlsec-bom.version>2.5.0</quarkus-xmlsec-bom.version>
        <!--
            Quarkus 轨道专用 override：仅保留 ddd4j 仓库**未管理**且 Quarkus 生态强约束的版本。
            1) jboss-logging：Quarkus 日志桥强制版本（ddd4j 走 Spring 链解析到 3.4.x/3.5.x，
               与 quarkus-core 字节码签名不兼容）
            2) asm 9.x：Quarkus 构建期字节码操作要求（ddd4j 链解析可能落到 5.x 老版本）

            jakarta.* API（jakarta.ws.rs-api 3.1.0、jakarta.xml.bind-api 3.0.1 等 Jakarta EE 9+
            命名空间版本）已上抛到 ddd4j 仓库 ddd4j-dependencies 统一管理，本模块不再重复声明。

            Maven 插件版本（maven-compiler / enforcer / surefire / failsafe / source / jar / resources /
            install / deploy / exec / git-commit-id / flatten / docker 等）由 ddd4j 仓库根 pom 统一管理，
            本模块不重复声明，避免版本漂移。
        -->
        <testcontainers-bom.version>2.0.5</testcontainers-bom.version>
        <!--
            Quarkus ecosystem arbitration. ddd4j-parent contributes direct dependencyManagement,
            which Maven ranks above an imported BOM even when the import is declared first. Keep
            overrides at version-family level here (never in leaf modules) and let the effective-POM
            gate detect every future unaccounted platform overlap.
        -->
        <asm.version>9.10.1</asm.version>
        <async-http-client.version>2.15.0</async-http-client.version>
        <awaitility.version>4.3.0</awaitility.version>
        <byte-buddy.version>1.18.8</byte-buddy.version>
        <checker-framework.version>4.2.0</checker-framework.version>
        <elasticsearch-client.version>9.4.1</elasticsearch-client.version>
        <flyway.version>12.0.0</flyway.version>
        <google-error_prone_annotations.version>2.49.0</google-error_prone_annotations.version>
        <google-j2objc-annotations.version>2.8</google-j2objc-annotations.version>
        <grpc.version>1.81.0</grpc.version>
        <hamcrest.version>2.2</hamcrest.version>
        <hibernate-validator.version>9.1.2.Final</hibernate-validator.version>
        <jakarta-json-bind.version>3.0.2</jakarta-json-bind.version>
        <jakarta-servlet.version>6.0.0</jakarta-servlet.version>
        <jakarta-websocket.version>2.1.1</jakarta-websocket.version>
        <jakarta.xml.bind-api.version>4.0.5</jakarta.xml.bind-api.version>
        <jboss-logging.version>3.6.3.Final</jboss-logging.version>
        <junit-jupiter.version>6.1.1</junit-jupiter.version>
        <kafka.version>4.2.1</kafka.version>
        <keycloak.version>26.0.10</keycloak.version>
        <kotlin-stdlib.version>2.4.0</kotlin-stdlib.version>
        <log4j2.version>2.26.0</log4j2.version>
        <micrometer.version>1.16.6</micrometer.version>
        <mockito.version>5.21.0</mockito.version>
        <mssql-jdbc.version>13.4.0.jre11</mssql-jdbc.version>
        <netty-tcnative.version>2.0.78.Final</netty-tcnative.version>
        <netty.version>4.1.136.Final</netty.version>
        <postgresql.version>42.7.13</postgresql.version>
        <protobuf-java.version>4.35.0</protobuf-java.version>
        <sshd.version>2.17.1</sshd.version>
        <additionalparam></additionalparam>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- NATS fixture 直接使用 JetStream 管理 API，沿用 ddd4j 兼容客户端版本。 -->
            <dependency>
                <groupId>io.nats</groupId>
                <artifactId>jnats</artifactId>
                <version>${jnats-compat.version}</version>
            </dependency>
            <!--
                1. Quarkus BOM 必须第一个 import。Maven 对重复管理项采用 first-import-wins，
                因此必须先锁定本轨道的 3.37.4，避免上游 ddd4j 或任何 Quarkiverse BOM 把
                runtime、deployment、test 或插件依赖带到其他 Quarkus 版本。
            -->
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                2. Testcontainers BOM 必须在 ddd4j 底座前 import。ddd4j 2.0.x 仍管理
                1.20.x 的专用模块；Maven 对重复管理项采用 first-import-wins，因此在此锁定
                2.0.5，防止旧模块回流。
            -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 3. ddd4j 底座后 import：保留非 Quarkus 第三方组件的统一管理。 -->
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-dependencies</artifactId>
                <version>${ddd4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Quarkus COLA adapter owns this optional ecosystem addition. -->
            <dependency>
                <groupId>com.alibaba.cola</groupId>
                <artifactId>cola-components-bom</artifactId>
                <version>${cola.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 2.1 本仓 ddd4j-quarkus-bom（独立 POM，无循环）：统一管理全部
                 ddd4j-quarkus-* 模块版本（${revision}），供框架模块与 samples 解析 -->
            <dependency>
                <groupId>io.ddd4j.quarkus</groupId>
                <artifactId>ddd4j-quarkus-bom</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 3. Quarkiverse 公共 BOM：仅导入面向业务项目的 BOM，排除 internal/test/parent 发布物 -->
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.amazonservices/quarkus-amazon-services-bom -->
            <dependency>
                <groupId>io.quarkiverse.amazonservices</groupId>
                <artifactId>quarkus-amazon-services-bom</artifactId>
                <version>${quarkus-amazon-services-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.artemis/quarkus-artemis-bom -->
            <dependency>
                <groupId>io.quarkiverse.artemis</groupId>
                <artifactId>quarkus-artemis-bom</artifactId>
                <version>${quarkus-artemis-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.azureservices/quarkus-azure-services-bom -->
            <dependency>
                <groupId>io.quarkiverse.azureservices</groupId>
                <artifactId>quarkus-azure-services-bom</artifactId>
                <version>${quarkus-azure-services-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.businessscore/quarkus-business-score-bom -->
            <dependency>
