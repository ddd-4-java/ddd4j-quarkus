<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus-dependencies</artifactId>
    <packaging>pom</packaging>
    <description>ddd4j-dependencies + quarkus-bom + Quarkus track overrides</description>

    <properties>
        <!-- ddd4j 底座 revision（必须与 ddd4j 仓库实际 deploy 的一致） -->
        <ddd4j.version>2.0.x20260625-SNAPSHOT</ddd4j.version>

        <!--
            Quarkus 轨道专用 override：ddd4j 没显式定义这些版本，由 Quarkus 生态强约束。
            1) jboss-logging：Quarkus 日志桥强制版本
            2) asm 9.x：Quarkus 构建期字节码操作要求
            3) jakarta.ws.rs-api 3.x：Quarkus 3 + Jakarta EE 9+ 命名空间（jakarta.ws.rs.*）；
               ddd4j 链解析可能落到 2.1.6（javax.ws.rs.*），与 quarkus-rest 不兼容
        -->
        <jboss-logging.version>3.6.3.Final</jboss-logging.version>
        <asm.version>9.9.1</asm.version>
        <jakarta.ws.rs-api.version>3.1.0</jakarta.ws.rs-api.version>
        <jakarta.xml.bind-api.version>3.0.1</jakarta.xml.bind-api.version>

        <!--
            Maven 插件版本（ddd4j 已统一管理；这里仅声明 Quarkus 业务 parent 必需的子集）
        -->
        <maven-docker-plugin.version>0.48.0</maven-docker-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 1. ddd4j 底座先 import：所有第三方组件版本（含 lombok/slf4j/jakarta-*/fuin-*/archunit/easyexcel 等）由 ddd4j 统一管理 -->
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-dependencies</artifactId>
                <version>${ddd4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 2. Quarkus BOM 后 import：Quarkus 框架版本优先（与 ddd4j 解耦） -->
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 3. ddd4j 平台核心模块坐标（业务项目可直接 <dependency>io.ddd4j:ddd4j-core</dependency>，版本由 ddd4j-bom 提供） -->
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-core</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>

            <!-- 4. Quarkus 轨道专用 override：仅保留 ddd4j 未显式管理、且 Quarkus 强约束的版本 -->
            <dependency>
                <groupId>org.jboss.logging</groupId>
                <artifactId>jboss-logging</artifactId>
                <version>${jboss-logging.version}</version>
            </dependency>
            <!-- Quarkus 构建需 ASM 9.x（ddd4j 链解析可能落到 5.x） -->
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-commons</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-tree</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-util</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-analysis</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <!-- Quarkus 3 + Jakarta EE 9+ 强制使用 jakarta.ws.rs.* 命名空间（覆盖 ddd4j 链解析的 2.1.6） -->
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.ws.rs-api.version}</version>
            </dependency>
            <!--
                jakarta.xml.bind-api 3.x：hutool-all / easyexcel 等传递依赖会引用 JAXBException 等类，
                必须用 3.x 命名空间（jakarta.xml.bind.*）才能在 Quarkus 3 + Jakarta EE 9+ 运行时解析。
            -->
            <dependency>
                <groupId>jakarta.xml.bind</groupId>
                <artifactId>jakarta.xml.bind-api</artifactId>
                <version>${jakarta.xml.bind-api.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
