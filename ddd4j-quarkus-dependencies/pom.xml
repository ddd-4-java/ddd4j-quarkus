<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-parent</artifactId>
        <version>2.0.x.20260630-SNAPSHOT</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>io.ddd4j.quarkus</groupId>
    <artifactId>ddd4j-quarkus-dependencies</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <description>ddd4j-dependencies + quarkus-bom + Quarkus track overrides</description>

    <properties>
        <!-- 本仓 revision / ddd4j 底座 revision（必须与 ddd4j 仓库实际 deploy 的一致） -->
        <revision>3.3.x.20260630-SNAPSHOT</revision>
        <ddd4j.version>2.0.x.20260630-SNAPSHOT</ddd4j.version>
        <quarkus.build.skip>false</quarkus.build.skip>
        <quarkus-bom.version>3.37.4</quarkus-bom.version>
        <quarkus-amazon-services-bom.version>3.21.0</quarkus-amazon-services-bom.version>
        <quarkus-artemis-bom.version>3.14.3</quarkus-artemis-bom.version>
        <quarkus-azure-services-bom.version>1.2.4</quarkus-azure-services-bom.version>
        <quarkus-business-score-bom.version>1.0.0</quarkus-business-score-bom.version>
        <quarkus-cxf-bom.version>3.38.0</quarkus-cxf-bom.version>
        <quarkus-flags-bom.version>1.0.0</quarkus-flags-bom.version>
        <quarkus-flow-bom.version>0.13.0</quarkus-flow-bom.version>
        <quarkus-google-cloud-services-bom.version>2.23.1</quarkus-google-cloud-services-bom.version>
        <quarkus-jberet-bom.version>2.11.0</quarkus-jberet-bom.version>
        <quarkus-jgit-bom.version>3.6.2</quarkus-jgit-bom.version>
        <quarkus-jpastreamer-bom.version>3.0.3.Final</quarkus-jpastreamer-bom.version>
        <quarkus-kafka-streams-processor-bom.version>6.0.7</quarkus-kafka-streams-processor-bom.version>
        <quarkus-langchain4j-bom.version>1.12.0</quarkus-langchain4j-bom.version>
        <quarkus-mcp-server-bom.version>1.13.1</quarkus-mcp-server-bom.version>
        <quarkus-openid-ssf-bom.version>0.0.3</quarkus-openid-ssf-bom.version>
        <quarkus-operator-sdk-bom.version>7.7.5</quarkus-operator-sdk-bom.version>
        <quarkus-vault-bom.version>4.8.0</quarkus-vault-bom.version>
        <quarkus-xmlsec-bom.version>2.5.0</quarkus-xmlsec-bom.version>
        <!--
            Quarkus 轨道专用 override：仅保留 ddd4j 仓库**未管理**且 Quarkus 生态强约束的版本。
            1) jboss-logging：Quarkus 日志桥强制版本（ddd4j 走 Spring 链解析到 3.4.x/3.5.x，
               与 quarkus-core 字节码签名不兼容）
            2) asm 9.x：Quarkus 构建期字节码操作要求（ddd4j 链解析可能落到 5.x 老版本）

            jakarta.* API（jakarta.ws.rs-api 3.1.0、jakarta.xml.bind-api 3.0.1 等 Jakarta EE 9+
            命名空间版本）已上抛到 ddd4j 仓库 ddd4j-dependencies 统一管理，本模块不再重复声明。

            Maven 插件版本（maven-compiler / enforcer / surefire / failsafe / source / jar / resources /
            install / deploy / exec / git-commit-id / flatten / docker 等）由 ddd4j 仓库根 pom 统一管理，
            本模块不重复声明，避免版本漂移。
        -->
        <jboss-logging.version>3.6.3.Final</jboss-logging.version>
        <asm.version>9.9.1</asm.version>
        <testcontainers-bom.version>1.20.4</testcontainers-bom.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 1. ddd4j 底座先 import：所有第三方组件版本（含 lombok/slf4j/jakarta-*/fuin-*/archunit/easyexcel 等）由 ddd4j 统一管理 -->
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-dependencies</artifactId>
                <version>${ddd4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 1.1 本仓 ddd4j-quarkus-bom（独立 POM，无循环）：统一管理全部
                 ddd4j-quarkus-* 模块版本（${revision}），供框架模块与 samples 解析 -->
            <dependency>
                <groupId>io.ddd4j.quarkus</groupId>
                <artifactId>ddd4j-quarkus-bom</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 2. Quarkus BOM 后 import：Quarkus 框架版本优先（与 ddd4j 解耦） -->
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 3. Quarkiverse 公共 BOM：仅导入面向业务项目的 BOM，排除 internal/test/parent 发布物 -->
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.amazonservices/quarkus-amazon-services-bom -->
            <dependency>
                <groupId>io.quarkiverse.amazonservices</groupId>
                <artifactId>quarkus-amazon-services-bom</artifactId>
                <version>${quarkus-amazon-services-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.artemis/quarkus-artemis-bom -->
            <dependency>
                <groupId>io.quarkiverse.artemis</groupId>
                <artifactId>quarkus-artemis-bom</artifactId>
                <version>${quarkus-artemis-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.azureservices/quarkus-azure-services-bom -->
            <dependency>
                <groupId>io.quarkiverse.azureservices</groupId>
                <artifactId>quarkus-azure-services-bom</artifactId>
                <version>${quarkus-azure-services-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.businessscore/quarkus-business-score-bom -->
            <dependency>
                <groupId>io.quarkiverse.businessscore</groupId>
                <artifactId>quarkus-business-score-bom</artifactId>
                <version>${quarkus-business-score-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.cxf/quarkus-cxf-bom -->
            <dependency>
                <groupId>io.quarkiverse.cxf</groupId>
                <artifactId>quarkus-cxf-bom</artifactId>
                <version>${quarkus-cxf-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.flags/quarkus-flags-bom -->
            <dependency>
                <groupId>io.quarkiverse.flags</groupId>
                <artifactId>quarkus-flags-bom</artifactId>
                <version>${quarkus-flags-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.flow/quarkus-flow-bom -->
            <dependency>
                <groupId>io.quarkiverse.flow</groupId>
                <artifactId>quarkus-flow-bom</artifactId>
                <version>${quarkus-flow-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.googlecloudservices/quarkus-google-cloud-services-bom -->
            <dependency>
                <groupId>io.quarkiverse.googlecloudservices</groupId>
                <artifactId>quarkus-google-cloud-services-bom</artifactId>
                <version>${quarkus-google-cloud-services-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.jberet/quarkus-jberet-bom -->
            <dependency>
                <groupId>io.quarkiverse.jberet</groupId>
                <artifactId>quarkus-jberet-bom</artifactId>
                <version>${quarkus-jberet-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.jgit/quarkus-jgit-bom -->
            <dependency>
                <groupId>io.quarkiverse.jgit</groupId>
                <artifactId>quarkus-jgit-bom</artifactId>
                <version>${quarkus-jgit-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.jpastreamer/quarkus-jpastreamer-bom -->
            <dependency>
                <groupId>io.quarkiverse.jpastreamer</groupId>
                <artifactId>quarkus-jpastreamer-bom</artifactId>
                <version>${quarkus-jpastreamer-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.kafkastreamsprocessor/quarkus-kafka-streams-processor-bom -->
            <dependency>
                <groupId>io.quarkiverse.kafkastreamsprocessor</groupId>
                <artifactId>quarkus-kafka-streams-processor-bom</artifactId>
                <version>${quarkus-kafka-streams-processor-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.langchain4j/quarkus-langchain4j-bom -->
            <dependency>
                <groupId>io.quarkiverse.langchain4j</groupId>
                <artifactId>quarkus-langchain4j-bom</artifactId>
                <version>${quarkus-langchain4j-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.mcp/quarkus-mcp-server-bom -->
            <dependency>
                <groupId>io.quarkiverse.mcp</groupId>
                <artifactId>quarkus-mcp-server-bom</artifactId>
                <version>${quarkus-mcp-server-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.openid-ssf/quarkus-openid-ssf-bom -->
            <dependency>
                <groupId>io.quarkiverse.openid-ssf</groupId>
                <artifactId>quarkus-openid-ssf-bom</artifactId>
                <version>${quarkus-openid-ssf-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.operatorsdk/quarkus-operator-sdk-bom -->
            <dependency>
                <groupId>io.quarkiverse.operatorsdk</groupId>
                <artifactId>quarkus-operator-sdk-bom</artifactId>
                <version>${quarkus-operator-sdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.vault/quarkus-vault-bom -->
            <dependency>
                <groupId>io.quarkiverse.vault</groupId>
                <artifactId>quarkus-vault-bom</artifactId>
                <version>${quarkus-vault-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.quarkiverse.xmlsec/quarkus-xmlsec-bom -->
            <dependency>
                <groupId>io.quarkiverse.xmlsec</groupId>
                <artifactId>quarkus-xmlsec-bom</artifactId>
                <version>${quarkus-xmlsec-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 4. ddd4j 平台核心模块坐标（纯 Java，零 Spring 依赖）。
                 显式声明 io.ddd4j:* 全部常用模块版本，避免 ddd4j-quarkus 子模块
                 必须依赖 ddd4j-quarkus-bom 才能解析版本。 -->
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-core</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-kit</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-annotation</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-cache</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <!-- 主仓 ddd4j-data-crypto 发布 POM 引用了 io.github.hiwepy:jackson-extension 但未带版本，
                 这里显式管理版本，确保传递依赖可解析（该 artifact 版本与 ddd4j 同步发布） -->
            <dependency>
                <groupId>io.github.hiwepy</groupId>
                <artifactId>jackson-extension</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <!-- 主仓 ddd4j-extension-qrcode 发布 POM 未声明 io.github.hiwepy:zxing-extension
                 （其源码引用 com.google.zxing.exception.* 由该库提供），此处显式管理版本，
                 qrcode 适配模块显式依赖以补齐运行时 classpath -->
            <dependency>
                <groupId>io.github.hiwepy</groupId>
                <artifactId>zxing-extension</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <!-- 主仓 ddd4j-auth-license 发布 POM 引用了 de.schlichtherle.truelicense 但未带版本，
                 这里显式管理版本（truelicense-core 1.33 为当前发布版本） -->
            <dependency>
                <groupId>de.schlichtherle.truelicense</groupId>
                <artifactId>truelicense-core</artifactId>
                <version>1.33</version>
            </dependency>
            <!--
                Agroal 连接池版本（显式覆盖）：ddd4j 底座 BOM 先 import，其 quarkus-bom 3.37.0
                管理 agroal-api 2.0（MultipleAcquisitionAction 枚举仅 warn/strict/off）；而
                quarkus-bom 3.37.0（实际 runtime）配套 agroal 3.2（枚举含 LENIENT，Quarkus 3.36
                默认 multiple-acquisition=lenient）。BOM import 冲突按"先声明者优先"仲裁，
                此处直接声明的 management 条目优先于 import 内容，保证 @QuarkusTest 启动时
                配置转换不失败。
            -->
            <dependency>
                <groupId>io.agroal</groupId>
                <artifactId>agroal-api</artifactId>
                <version>3.2</version>
            </dependency>
            <dependency>
                <groupId>io.agroal</groupId>
                <artifactId>agroal-narayana</artifactId>
                <version>3.2</version>
            </dependency>
            <dependency>
                <groupId>io.agroal</groupId>
                <artifactId>agroal-pool</artifactId>
                <version>3.2</version>
            </dependency>
            <!--
                Hibernate ORM 版本（显式覆盖）：主仓 ddd4j-dependencies 先 import
                hibernate-platform 6.6.40（BootLogging 无 BOOT_LOGGER 字段，与 Quarkus
                不兼容：@QuarkusTest / quarkus:build 报 NoSuchFieldError）；quarkus-bom
                3.37.0（实际 runtime）配套 Hibernate ORM 7.4.1.Final。此处直接声明的 management 条目优先于
                import 内容（同 agroal 处理），保证 quarkus 轨道运行时版本一致。
            -->
            <dependency>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-core</artifactId>
                <version>7.4.1.Final</version>
            </dependency>
            <dependency>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-graalvm</artifactId>
                <version>7.4.1.Final</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-runtime-quarkus</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <!-- 4.1 本仓 ddd4j-quarkus-* 模块统一版本管理。
                 ddd4j-quarkus-bom 也声明了这些，但部分聚合子模块（如 ddd4j-quarkus-mq）
                 没有 import bom，需要在 dependencies 顶层提供，避免子模块版本解析失败。 -->
            <dependency>
                <groupId>io.ddd4j.quarkus</groupId>
                <artifactId>ddd4j-quarkus-mq-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.quarkus</groupId>
                <artifactId>ddd4j-quarkus-mq-testcontainers</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 5. Quarkus 轨道专用 override：仅保留 ddd4j 未显式管理、且 Quarkus 强约束的版本 -->
            <dependency>
                <groupId>org.jboss.logging</groupId>
                <artifactId>jboss-logging</artifactId>
                <version>${jboss-logging.version}</version>
            </dependency>
            <!-- Quarkus 构建需 ASM 9.x（ddd4j 链解析可能落到 5.x） -->
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-commons</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-tree</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-util</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-analysis</artifactId>
                <version>${asm.version}</version>
            </dependency>

            <!-- 6. Testcontainers 集成（仅 ddd4j-quarkus-mq-testcontainers 等模块需要） -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <!--
        框架模块公共测试依赖（继承本 POM 的模块：mq/extensions/auth/data/cache/ddd/web）：
        @QuarkusTest 需要 quarkus-junit；HTTP 断言用 rest-assured；断言用 assertj；
        junit4 供 Quarkus Dev Services 处理器加载（TestRule）。业务项目父 POM
        （ddd4j-quarkus-parent）同样提供这些依赖并覆盖插件配置，不受影响。
    -->
    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- assertj：框架模块测试断言（data-panache/cache/auth-jwt 等的 *Test 使用），
             版本由 quarkus-bom 管理。缺失会导致继承模块测试编译失败。 -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>



    <build>
        <pluginManagement>
            <plugins>
                <!-- Quarkus 构建（模块显式声明时生效，如 mq-testcontainers） -->
                <plugin>
                    <groupId>io.quarkus.platform</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus-bom.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <skip>${quarkus.build.skip}</skip>
                    </configuration>
                </plugin>
                <!-- 编译：release + -parameters（覆盖 ddd4j-parent 的 source/target） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <!-- Unit Test：JVM LogManager 切到 JBoss，避免与 Quarkus 日志桥接冲突 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <!-- Integration Test：JBoss LogManager -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
