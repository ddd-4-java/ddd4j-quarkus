<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>ddd4j-quarkus-data-panache</artifactId>
    <description>
        ddd4j-quarkus 数据层 - Panache ORM：
        多租户实体基类（TenantAwareEntity）、雪花 ID 生成器（SnowflakeIdGenerator）、查询构建辅助（RepositoryUtil）。
        复用 ddd4j-core 契约（Page 等），提供 Quarkus Panache 原生实现。
    </description>

    <dependencies>
        <!-- ddd4j 底座核心契约 -->
                <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
        </dependency>
        <!-- Quarkus 核心 -->
                <dependency>
            <groupId>io.ddd4j.quarkus</groupId>
            <artifactId>ddd4j-quarkus-core</artifactId>
        </dependency>
        <!-- Quarkus Panache ORM -->
                <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <!-- Quarkus CDI -->
                <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
    </dependencies>

</project>
