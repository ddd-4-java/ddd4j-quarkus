<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.quarkus</groupId>
        <artifactId>ddd4j-quarkus-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-quarkus-dependencies/pom.xml</relativePath>
    </parent>
    <artifactId>ddd4j-quarkus-data</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j 数据层在 Quarkus 轨道的桥接聚合。
        对齐 ddd4j-boot-data 的深度适配边界；Quarkus 轨道以 Panache 承接 ORM 适配，不直接复制 Spring/MyBatis 适配形态。
        参照 ddd4j-data 多模块范式，按子领域拆分：
        - panache（Panache 多租户实体基类 + 雪花 ID + 查询辅助）
        - crypto（加解密策略 CDI 桥接）
        - logs（API 操作日志 CDI 桥接）
        - external（外部服务 CDI 桥接）
        - datascope（数据权限 CDI 桥接）
        复用 ddd4j-data 各子模块的纯 Java 实现，本层提供 CDI Bean / Quarkus 扩展桥接。
    </description>

    <modules>
        <module>ddd4j-quarkus-data-panache</module>
        <module>ddd4j-quarkus-data-jpa</module>
        <module>ddd4j-quarkus-data-event-store-panache</module>
        <module>ddd4j-quarkus-data-crypto</module>
        <module>ddd4j-quarkus-data-logs</module>
        <module>ddd4j-quarkus-data-external</module>
        <module>ddd4j-quarkus-data-datascope</module>
    </modules>

</project>
